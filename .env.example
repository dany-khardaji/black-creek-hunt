# Copy this file to .env and fill in real values.
# .env is gitignored. This file is committed.
# NEVER put a real secret in this file.

# Signs and verifies session JWTs. Anyone holding this can mint valid admin
# tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace_me

# How long a session lasts before the member signs in again. 24 hours.
JWT_EXPIRE_MINUTES=1440

# Path to the SQLite file, relative to backend/
DATABASE_URL=replace_me
DATABASE_URL_POOLED=replace_me
TEST_DATABASE_URL=replace_me

# --- Google sign-in -------------------------------------------------------
# From the Google Cloud console: APIs & Services > Credentials >
# OAuth 2.0 Client ID of type "Web application".
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me

# Where this app is reached. Used to build the OAuth redirect URI, which must
# match an Authorized redirect URI in the Google Cloud console exactly:
#   {APP_ORIGIN}/api/auth/google/callback
# Sign-in fails if the two differ, including the scheme or a trailing slash.
APP_ORIGIN=http://localhost:8000

# Set to 1 in production so the session cookie carries the Secure flag.
# Leave 0 for local development over plain http, or the browser drops it.
SESSION_COOKIE_SECURE=0
