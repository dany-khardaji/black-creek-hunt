# Copy this file to .env and fill in real values.
# .env is gitignored. This file is committed.
# Never put a real secret in this file.

# Signs and verifies JWTs. Anyone holding this can mint valid admin tokens.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace_me

# How long a login lasts before the member has to sign in again.
JWT_EXPIRE_MINUTES=10080

# Path to the SQLite file, relative to backend/
DATABASE_PATH=blackcreek.db

# Comma separated origins allowed to call this API.
# Local dev values. Lock this to the production domain in Phase 10.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5500
